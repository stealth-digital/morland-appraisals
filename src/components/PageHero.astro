---
import { fullBleed } from '../lib/cloudinary';

interface Props {
  image: string;
  alt: string;
  title: string;
  lede: string;
}

const { image, alt, title, lede } = Astro.props;
const img = fullBleed(image);
---

<section class="hero hero--page">
  <img class="hero-bg" src={img.src} srcset={img.srcset} sizes={img.sizes} alt={alt} fetchpriority="high" decoding="async" />
  <div class="container">
    <div class="hero-copy">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </div>
  </div>
</section>

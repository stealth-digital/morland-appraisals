---
import { fullBleed } from '../lib/cloudinary';

interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
const img = fullBleed(image);
---

<section class="photo-band">
  <img src={img.src} srcset={img.srcset} sizes={img.sizes} alt={alt} loading="lazy" decoding="async" />
</section>

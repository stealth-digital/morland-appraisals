---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { aboutPage } from '../lib/schema';

const base = 'https://res.cloudinary.com/dj76bnpni/image/upload/';
const headshot = (v: string, file: string) =>
  `${base}f_auto,q_auto,w_240,h_240,c_fill,g_face/${v}/${file}`;

const team = [
  {
    image: headshot('v1788982286', 'brad-minogue-morland-appraisals_tivqsa.jpg'),
    name: 'Brad Minogue',
    title: 'President',
    bio: 'Brad is a candidate appraiser with over 20 years of service in the residential and commercial field. He has extensive experience in the area of valuation and analysis of all common property types, and commercial properties. Brad is owner and manager of Morland Real Estate Appraisal Inc.',
    cell: { label: '705-840-9966', href: 'tel:+17058409966' },
    fax: '705-495-4423',
  },
  {
    image: headshot('v1788982286', 'gord-morland-morland-appraisals_j5prye.jpg'),
    name: 'Gordon Morland',
    title: 'Certified CRA Appraiser',
    bio: 'Gordon is a certified CRA appraiser with expertise in residential, recreational, condominium, multi-residential, commercial, industrial, institutional, agricultural, vacant land, specialty and mixed-use properties.',
    cell: { label: '705-471-0074', href: 'tel:+17054710074' },
  },
  {
    image: headshot('v1788982284', 'tom-stone-morland-appraisals_gnf8tl.jpg'),
    name: 'Thomas Stone',
    title: 'Certified CRA Appraiser',
    bio: 'Thomas is a certified CRA appraiser.',
    cell: { label: '705-498-0544', href: 'tel:+17054980544' },
  },
  {
    image: headshot('v1788982284', 'steve-johnson-morland-appraisals_artqum.jpg'),
    name: 'Steve Johnson',
    title: 'Certified CRA Appraiser',
    bio: 'Steve is a certified CRA appraiser.',
    cell: { label: '705-492-3507', href: 'tel:+17054923507' },
  },
  {
    image: headshot('v1788982284', 'joey-boulet-morland-appraisals_c8znyp.jpg'),
    name: 'Joey Boulet',
    title: 'P. App, AACI',
    bio: null,
    cell: { label: '705-477-5303', href: 'tel:+17054775303' },
  },
];

const schema = aboutPage(team);
---

<BaseLayout
  title="About Us | Morland Real Estate Appraisals"
  description="Meet the team at Morland Real Estate Appraisals, a full service appraisal firm in North Bay since the late 1980s."
  hero={`${base}v1788982283/modern-office-building_bl1clt.png`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <PageHero
    image={`${base}f_auto,q_auto,w_1920/v1788982283/modern-office-building_bl1clt.png`}
    alt="Office building"
    title="About Us"
    lede="A full service appraisal firm, approved and licensed by the Appraisal Institute of Canada, serving Northeastern Ontario since the late 1980s."
  />

  <section class="section">
    <div class="container who-grid">
      <div>
        <h2>Who we are?</h2>
        <p style="margin-top: var(--space-4)">Morland Real Estate Appraisals Ltd is a full service professional appraisal company approved and licensed by the Appraisal Institute of Canada. We specialize in residential and commercial real estate appraisals in the North Bay and surrounding area.</p>
        <p>In the late 1980's, Morland's was founded with the understanding that property owners, investors, purchasers and a variety of other institutions required accurate, efficient and timely appraisal services. Backed by an in-depth understanding of real estate concepts, strategies and most importantly a desire to help local individuals and companies, Morland Real Estate Appraisals quickly became a trusted source in the north.</p>
        <p>Over many years we have made it our goal to provide the most competent, friendly service and expertise available. Our appraisals are based on extensive knowledge, technology and experience in evaluating land and buildings. As real estate and real property usually forms the most significant portion of a family's assets, simply providing appraisals sometimes isn't enough. We strive to provide a greater flexibility and understanding in assisting our clients. As such, we are proud to be a leader for residential and commercial appraisals in Northeastern Ontario.</p>
        <p>Our work spans <a href="/residential-appraisals">residential appraisals</a>, <a href="/commercial-appraisals">commercial appraisals</a>, <a href="/hunting-fishing-lodge-appraisals">hunting and fishing lodges</a> and <a href="/ontario-golf-course-appraisals">golf courses</a> across our <a href="/service-area">Northeastern Ontario service area</a>.</p>
      </div>
      <div class="photo">
        <img
          src={`${base}f_auto,q_auto,w_540/v1788982280/downtown-north-bay-main-street_pw20b3.png`}
          srcset={`${base}f_auto,q_auto,w_360/v1788982280/downtown-north-bay-main-street_pw20b3.png 360w, ${base}f_auto,q_auto,w_540/v1788982280/downtown-north-bay-main-street_pw20b3.png 540w, ${base}f_auto,q_auto,w_720/v1788982280/downtown-north-bay-main-street_pw20b3.png 720w, ${base}f_auto,q_auto,w_1080/v1788982280/downtown-north-bay-main-street_pw20b3.png 1080w`}
          sizes="(max-width: 900px) calc(100vw - 48px), 540px"
          alt="Main Street, downtown North Bay"
          width="540"
          height="540"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section--neutral" id="team">
    <div class="container">
      <div class="section-heading">
        <h2>Meet Our Team!</h2>
      </div>
      <ul class="team">
        {team.map((member) => (
          <li class="member">
            <img src={member.image} alt={member.name} width="120" height="120" loading="lazy" />
            <div><h3>{member.name}</h3><span class="title">{member.title}</span></div>
            {member.bio && <p>{member.bio}</p>}
            <div class="numbers">
              {member.cell && <span>Cell: <a href={member.cell.href}>{member.cell.label}</a></span>}
              <span>Office: <a href="tel:+17054743500">705-474-3500</a></span>
              {'fax' in member && <span>Fax: {member.fax}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

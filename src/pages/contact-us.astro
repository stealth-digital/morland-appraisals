---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactPage } from '../lib/schema';

const base = 'https://res.cloudinary.com/dj76bnpni/image/upload/';
---

<BaseLayout
  title="Contact Us | Morland Real Estate Appraisals"
  description="Contact Morland Real Estate Appraisals in North Bay to request a residential or commercial appraisal."
  hero={`${base}v1788982278/lakefront-dock-patio-banner_clq6tq.png`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(contactPage)} />

  <PageHero
    image={`${base}f_auto,q_auto,w_1920/v1788982278/lakefront-dock-patio-banner_clq6tq.png`}
    alt="Lakefront dock and patio"
    title="Contact Us"
    lede="We want to help with your residential or commercial appraisal. Contact us at Morland Real Estate Appraisals today. Fill out the form and one of our qualified representatives will assist you."
  />

  <section class="section">
    <div class="container copy-form">
      <div class="contact-details">
        <h2 class="sr-only">Our contact details</h2>
        <div>
          <span class="eyebrow">Call us</span>
          <a class="big-phone" href="tel:+17054743500">(705) 474-3500</a>
        </div>
        <div class="detail">
          <h3>Hours</h3>
          <p>Monday to Friday, 9 am to 5 pm</p>
        </div>
        <div class="detail">
          <h3>Address</h3>
          <address>382 Fraser Street<br />North Bay, ON P1B 3W7</address>
          <p style="margin-top: var(--space-2)"><a href="https://maps.google.com/?q=382+Fraser+Street+North+Bay+ON+P1B+3W7" target="_blank" rel="noopener">Get directions</a></p>
        </div>
        <div class="detail">
          <h3>Email</h3>
          <p><a href="mailto:info@morlandappraisals.org">info@morlandappraisals.org</a></p>
        </div>
      </div>

      <ContactForm
        heading="Request an appraisal"
        intro="Fill out the form and one of our qualified appraisers will contact you."
      />
    </div>
  </section>

  <section class="map-band">
    <iframe
      src="https://maps.google.com/maps?q=382%20Fraser%20St%2C%20North%20Bay%2C%20ON%20P1B%203W7%2C%20Canada&t=m&z=15&output=embed&iwloc=near"
      title="Map showing Morland Real Estate Appraisals at 382 Fraser Street, North Bay"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>
